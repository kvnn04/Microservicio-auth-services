# =============================================================================
# auth-identity-service — plantilla de entorno
# Uso: cp .env.example .env  →  completa los valores CAMBIAR  →
#      docker compose up -d --build
# El archivo .env NUNCA se commitea (ver .gitignore).
# Detalle operativo completo: docs/PRODUCCION.md
# =============================================================================

# --- Modo ------------------------------------------------------------------
# development: claves efímeras si faltan, cookies sin Secure, logs WARN.
# production: exige SESSION_SIGNING_KEY (falla sin ella).
# production-strict: además rate-limit fail-closed (falla sin Redis).
ENV=development

# --- Red y URLs (dentro de compose se resuelven los nombres de servicio) ---
HTTP_ADDR=:8080
# Go local (fuera de docker): postgres://auth:auth@localhost:5432/auth_db?sslmode=disable
DATABASE_URL=postgres://auth:auth@postgres:5432/auth_db?sslmode=disable
# Go local: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
# Brokers Kafka (el compose lo expone en 9092 solo con --profile kafka).
KAFKA_BROKERS=kafka:9092
# Base pública del front (links de emails) y de esta API (callbacks federados).
FRONT_BASE_URL=http://localhost:3000
API_PUBLIC_BASE=http://localhost:8080

# --- Postgres (compose crea el volumen pgdata; CAMBIAR password en prod) ---
POSTGRES_USER=auth
POSTGRES_PASSWORD=auth # CAMBIAR en producción (genera una larga aleatoria)
POSTGRES_DB=auth_db

# --- SMTP (el worker envía la cola email_queue) ------------------------------
# Desarrollo: Mailhog del compose (bandeja en http://localhost:8025).
# Producción/pruebas reales: relay con autenticación (ej. Gmail).
# IMPORTANTE Gmail: puerto 587 con STARTTLS (NO el 465: este servicio no
# hace TLS implícito), cuenta con verificación en 2 pasos + contraseña de
# aplicación de 16 letras (NO tu clave normal; se genera en Cuenta de
# Google > Seguridad; límite aprox. 500 envíos/día). El remitente envelope
# debe ser tu misma dirección pelada (Gmail lo exige; el nombre visible
# "Que Sale Ahora!" va en el front o asunto, no acá).
MAIL_SMTP_ADDR=mailhog:1025
# Producción Gmail: MAIL_SMTP_ADDR=smtp.gmail.com:587
MAIL_FROM=no-reply@example.com
# Producción Gmail: MAIL_FROM=kevin.alexandroherrera04@gmail.com
SMTP_USER= # CAMBIAR: tu-cuenta@gmail.com (vacío = anónimo, solo Mailhog/dev)
SMTP_PASS= # CAMBIAR: contraseña de aplicación (vault; jamás al repo ni al chat)

# --- Clave de firma de Access JWT (Ed25519) — CAMBIAR SIEMPRE ---------------
# Formato: base64 de 32B (seed) o 64B (privada). Genera UNA NUEVA con:
#   go run ./scripts/gen_ed25519 [kid]
# Guarda la privada en tu vault (KMS/env), NUNCA en el repo.
# Rotación manual (no hay automática): ver docs/PRODUCCION.md §Rotación.
SESSION_SIGNING_KEY=
# Identificador de clave (cámbialo en cada rotación, ej. 2026-11-a).
SESSION_SIGNING_KID=2026-10-a
# Emisor y audiencia de tus tokens (úsalos también en tus gateways/APIs).
SESSION_ISS=https://auth.example.com # CAMBIAR por tu dominio
SESSION_AUD=api

# --- Secreto legacy HS256 (transición/federado) ------------------------------
# 32+ caracteres aleatorios. Se usa para pre-tokens MFA y compatibilidad.
SESSION_SECRET=cambia-este-secreto-32bytes-minimo!!!!

# --- Cifrado de secretos TOTP (AES-256-GCM) — CAMBIAR SIEMPRE ----------------
# Formato: 64 caracteres hex (32 bytes). Genera con (PowerShell):
#   -join ((1..64) | % { '0123456789abcdef'[(Get-Random -Max 16)] })
# o (bash): openssl rand -hex 32
# Sin esta clave la API NO arranca (fail-fast a propósito).
MFA_SECRETS_KEY=
# Nombre visible en apps authenticator al escanear el QR.
MFA_ISSUER=Example # CAMBIAR por tu marca

# --- Pepper de contraseñas/códigos (defensa extra, opcional pero recomendado)
# Cadena larga aleatoria y DISTINTA por ambiente. Si la cambias después,
# los hashes existentes SIGUEN válidos solo si conservas la anterior en
# PEPPER_PREV (una rotación por vez).
PASSWORD_PEPPER=
# PEPPER_PREV=

# --- Proveedor federado Google (OAuth2/OIDC, CU-REG-04) ----------------------
# Sin Client ID, el flujo federado responde error (el resto funciona).
ALLOWED_PROVIDERS=google
FEDERATED_GOOGLE_CLIENT_ID=TU_CLIENT_ID_DE_GOOGLE_CLOUD.apps.googleusercontent.com
FEDERATED_GOOGLE_CLIENT_SECRET= # CAMBIAR (vault; secreto OAuth de Google Cloud)
FEDERATED_GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/federated/google/callback # CAMBIAR en prod

# --- Timeouts y comportamiento ------------------------------------------------
# Timeout de consulta HIBP (brechas). Sin internet usa lista local (WARN).
HIBP_TIMEOUT_MS=800
# Step-Up: false = vale sesión fresca O token (compatible); true = exige
# token scopeado siempre (más estricto, más fricción).
ENFORCE_STEP_UP_TOKEN=false
