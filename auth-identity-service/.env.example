# Desarrollo con Docker (recomendado: nada corre en tu máquina salvo contenedores)
#   1. docker compose up -d --build postgres redis mailhog api worker
#   2. Aplicar migraciones (una vez, en orden):
#      Get-Content scripts/migrations/20261005_001_create_users_outbox.up.sql | docker exec -i auth-identity-service-postgres-1 psql -U auth -d auth_db
#      Get-Content scripts/migrations/20261005_002_verify_otp.up.sql | docker exec -i auth-identity-service-postgres-1 psql -U auth -d auth_db
#   3. Probar: curl http://localhost:8080/healthz  |  Mailhog en http://localhost:8025
#   4. Ver logs: docker compose logs -f api worker
#   5. Apagar: docker compose down  (con -v si quieres borrar la DB local)
#
# Desarrollo con Go local (alternativo)
#   cp .env.example .env  →  docker compose up -d postgres redis mailhog  →  go run ./cmd/api
#
# --- Variables (los servicios api/worker del compose ya llevan las internas) ---
# Para Go local usa estas (hosts localhost):
DATABASE_URL=postgres://auth:auth@localhost:5432/auth_db?sslmode=disable
REDIS_URL=redis://localhost:6379/0
KAFKA_BROKERS=localhost:9092
HTTP_ADDR=:8080
FRONT_BASE_URL=http://localhost:3000
MAIL_SMTP_ADDR=localhost:1025
MAIL_FROM=no-reply@example.com
ENV=development
PASSWORD_PEPPER=
HIBP_TIMEOUT_MS=800
# --- CU-REG-04 federado Google (MVP) ---
ALLOWED_PROVIDERS=google
FEDERATED_GOOGLE_CLIENT_ID=
FEDERATED_GOOGLE_CLIENT_SECRET=
FEDERATED_GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/federated/google/callback
SESSION_SECRET=
# --- CU-AUTH-04 emisión enterprise (Ed25519 + families) ---
# --- CU-AUTH-06 step-up (revalidación fresca 5min / token 1-uso-1-scope 5min) ---
# STEP_UP_MAX_AGE=300s y STEP_UP_TTL=300s son consts de dominio (reglas fijas).
# ENFORCE_STEP_UP_TOKEN=true exige token incluso con sesión fresca (default false).
ENFORCE_STEP_UP_TOKEN=false
# Genera con: go run ./scripts/gen_ed25519 [kid]
# Privada base64 (seed 32B) → KMS/env, NUNCA al repo. Pública → signing_keys.pub_b64.
SESSION_SIGNING_KEY=
SESSION_SIGNING_KID=2026-10-a
SESSION_ISS=https://auth.example.com
SESSION_AUD=api
# MAX_SESSIONS_PER_USER default 20 en dominio (configurable vía deploy/docs SES-03).
# Solo tests/E2E contra fake-IdP (nunca en prod):
# FEDERATED_ISSUER=http://localhost:8099
# FEDERATED_DISCOVERY_URL=
# FEDERATED_TOKEN_URL=
# FEDERATED_JWKS_URL=
